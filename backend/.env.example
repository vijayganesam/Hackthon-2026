PORT=3001
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Pega DX API (server-side only — never expose these to the frontend)
PEGA_DX_BASE_URL=https://your-pega-tenant.pegace.net/prweb
PEGA_CLIENT_ID=your-pega-client-id
PEGA_CLIENT_SECRET=your-pega-client-secret
PEGA_CASE_TYPE_ID=GNet-Telecom-Work-ServiceRequest

# Pega property that stores the Customer ID on the case (read by the data view as Customer.AccountNumber).
PEGA_CUSTOMER_ID_FIELD=Customer.AccountNumber
